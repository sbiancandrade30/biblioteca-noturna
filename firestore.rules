rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'sbiancandrade@gmail.com';
    }

    function validMaximumDates(value) {
      return value == null || (value is int && value >= 1 && value <= 31);
    }

    function respectsDateLimit() {
      let maximum = get(/databases/$(database)/documents/settings/active-poll).data.get('maxDates', 3);
      return maximum == null || request.resource.data.dates.size() <= maximum;
    }

    match /settings/active-poll {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.key is string
        && request.resource.data.status in ['open', 'closed']
        && (request.resource.data.chosenDate == null || request.resource.data.chosenDate is string)
        && validMaximumDates(request.resource.data.get('maxDates', 3));
      allow delete: if false;
    }

    match /polls/{pollId}/responses/{responseId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name in [
          'Ana Cristina', 'Bianca', 'Larissa', 'Luana',
          'Maria Eduarda', 'Pricila', 'Rhullya', 'Tainara'
        ]
        && responseId == request.resource.data.name
        && request.resource.data.dates is list
        && respectsDateLimit();
      allow delete: if isAdmin();
    }
  }
}
